{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gestão 360",
  "version": "0.1.0",
  "identifier": "br.gestao360.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Gestão 360",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "windows": {
      "wix": {
        "language": ["pt-BR"]
      },
      "nsis": {
        "languages": ["PortugueseBR"]
      }
    }
  }
}
